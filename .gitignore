# Local conversation logs contain session metadata and machine-specific paths.
/docs/conversation/

# Tooling and local agent state — never shipped, never versioned.
.codegraph/
.claude/

# fstar workflow data: tasks/specs/archive ARE tracked; only runtime state,
# local overrides, and identity stay local.
.fstar/runtime/
.fstar/*.local.yaml
.fstar/.identity


# Python bytecode and local caches.
__pycache__/
*.py[cod]

# Node/npm local artifacts.
node_modules/
npm-debug.log*
*.tgz

# OS noise.
.DS_Store

# Host-generated local directories (agent workspaces).
.agents/
.codex/
